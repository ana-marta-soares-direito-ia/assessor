{
  "manifest_version": 3,
  "name": "Alerta Phishing para Gmail",
  "version": "1.0.1",
  "description": "Analisa a mensagem aberta no Gmail e avisa quando apresenta sinais de fraude (phishing). A análise é feita no computador. Ana Marta Soares, Especialista em IA aplicada ao Direito.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Alerta Phishing", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }, "default_popup": "opcoes.html" },
  "options_ui": { "page": "opcoes.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["nacl-fast.min.js", "licenca.js", "motor.js", "vista.js", "conteudo.js"], "css": ["estilo.css", "gmail.css"], "run_at": "document_idle" }
  ]
}
